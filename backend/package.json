{
  "name": "r59-backend",
  "version": "1.0.0",
  "description": "Backend for Photographer Portfolio",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "deploy": "wrangler deploy --minify --keep-vars",
    "sync-admin": "node --experimental-strip-types scripts/sync-admin.ts",
    "sync-defaults": "node --experimental-strip-types scripts/sync-defaults.ts",
    "sync-frontend": "node --experimental-strip-types scripts/sync-frontend.ts",
    "bundle:admin-worker": "node --experimental-strip-types scripts/bundle-admin-workers.ts",
    "build:admin": "tsc -p ../admin && pnpm run bundle:admin-worker",
    "build": "pnpm run build:admin && pnpm run sync-frontend && pnpm run sync-defaults && pnpm run sync-admin && pnpm run bundle:admin-worker",
    "db:init": "wrangler d1 create r59_db",
    "db:reset": "wrangler d1 execute r59_db --local --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test:prepare": "pnpm run sync-frontend && pnpm run sync-admin",
    "test": "node --import ./test/ts-resolver.mjs --test test/*.test.ts",
    "test:coverage": "node --import ./test/ts-resolver.mjs --test --experimental-test-coverage test/*.test.ts",
    "ub:check": "node scripts/check-ub-metrics.mjs --strict --max-cc=50"
  },
  "dependencies": {
    "hono": "4.13.18",
    "square": "46.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "typescript": "7.0.2",
    "wrangler": "4.162.0"
  },
  "overrides": {
    "follow-redirects": ">=1.16.2"
  }
}
