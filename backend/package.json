{
  "name": "r59-backend",
  "version": "1.0.0",
  "description": "Backend for Photographer Portfolio",
  "main": "src/index.ts",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "sync-admin": "node -e \"const fs=require('fs'); fs.mkdirSync('public/admin', {recursive:true}); fs.cpSync('../admin', 'public/admin', {recursive:true, filter: (src) => !src.endsWith('.md')});\"",
    "build": "node -e \"const fs=require('fs'); fs.mkdirSync('public/admin', {recursive:true}); fs.cpSync('../admin', 'public/admin', {recursive:true, filter: (src) => !src.endsWith('.md')});\"",
    "db:init": "wrangler d1 create r59_db",
    "db:reset": "wrangler d1 execute r59_db --local --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/s3-request-presigner": "3.1132.0",
    "hono": "4.13.13",
    "square": "45.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "typescript": "5.9.3",
    "wrangler": "4.151.1"
  }
}
